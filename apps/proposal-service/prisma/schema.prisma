// Proposal Service Schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProposalStatus {
  DRAFT
  SENT
  ARCHIVED
}

model Proposal {
  id             String            @id @default(uuid())
  userId         String
  profileId      String
  
  // Job details
  jobId          String?
  jobUrl         String?
  jobTitle       String?
  jobDescription String?           @db.Text
  
  // Version tracking
  currentVersion Int               @default(1)
  
  // Status
  status         ProposalStatus    @default(DRAFT)
  
  // Timestamps
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  
  // Relations
  versions       ProposalVersion[]

  @@index([userId])
  @@index([profileId])
  @@index([jobId])
  @@index([status])
  @@index([createdAt])
}

model ProposalVersion {
  id         String   @id @default(uuid())
  proposalId String
  version    Int
  
  // Content
  content    String   @db.Text
  
  // Metadata about how this was generated
  promptMeta Json?    // { tone, style, length, profileOverrides }
  
  // Timestamp
  createdAt  DateTime @default(now())
  
  // Relations
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, version])
  @@index([proposalId])
}
