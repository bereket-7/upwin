DATABASE_URL="postgresql://postgres:password@localhost:5432/upwin_auth?schema=public"
JWT_SECRET=change-me-in-local-dev
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS (comma-separated; no wildcards with credentials)
ALLOWED_ORIGINS=http://localhost:3000

# Admin seed (optional; never log this value)
ADMIN_SEED_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID="google-client-id"
GOOGLE_CLIENT_SECRET="google-client-secret"

# LinkedIn OAuth
LINKEDIN_CLIENT_ID="linkedin-client-id"
LINKEDIN_CLIENT_SECRET="linkedin-client-secret"

# OAuth Callback URLs
CALLBACK_URL="http://localhost:3008"
PORT=3008

# Downstream services (account deletion cascade)
PROFILE_SERVICE_URL=http://localhost:3009/api
PROPOSAL_SERVICE_URL=http://localhost:3010/api

# Mailing
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Upwin Support" <noreply@upwin.com>

# Frontend origin for OAuth redirects and email links (separate FE repo)
FRONTEND_URL=http://localhost:3000
