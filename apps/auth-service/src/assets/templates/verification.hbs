<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Email</title>
    <!--[if mso]>
    <noscript>
    <xml>
    <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
    </o:OfficeDocumentSettings>
    </xml>
    </noscript>
    <![endif]-->
    <style>
        body {
            margin: 0;
            padding: 0;
            width: 100% !important;
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
            background-color: #f3f4f6;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        table {
            border-spacing: 0;
            border-collapse: collapse;
            table-layout: fixed;
            margin: 0 auto;
        }

        .wrapper {
            width: 100%;
            table-layout: fixed;
            background-color: #f3f4f6;
            padding-bottom: 40px;
        }

        .main {
            background-color: #ffffff;
            margin: 0 auto;
            width: 100%;
            max-width: 600px;
            border-spacing: 0;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }

        .content {
            padding: 48px 32px;
            text-align: left;
            color: #1f2937;
            line-height: 1.6;
        }

        .header {
            padding: 40px 0 20px 0;
            text-align: center;
            background-color: #ffffff;
        }

        .logo {
            font-size: 28px;
            font-weight: 800;
            color: #0ea5e9;
            text-decoration: none;
            letter-spacing: -0.025em;
        }

        h1 {
            font-size: 24px;
            font-weight: 700;
            color: #111827;
            margin-bottom: 24px;
            letter-spacing: -0.025em;
        }

        p {
            font-size: 16px;
            margin-bottom: 24px;
            color: #4b5563;
        }

        .button-container {
            padding: 32px 0;
            text-align: center;
        }

        .button {
            background-color: #0ea5e9;
            background-image: linear-gradient(to bottom right, #0ea5e9, #2563eb);
            border-radius: 8px;
            color: #ffffff !important;
            display: inline-block;
            font-size: 16px;
            font-weight: 600;
            line-height: 50px;
            text-align: center;
            text-decoration: none;
            width: 240px;
            -webkit-text-size-adjust: none;
            box-shadow: 0 10px 15px -3px rgba(14, 165, 233, 0.3);
        }

        .footer {
            padding: 32px;
            text-align: center;
            font-size: 14px;
            color: #9ca3af;
        }

        .divider {
            border-top: 1px solid #e5e7eb;
            margin: 32px 0;
        }

        .security-note {
            font-size: 13px;
            color: #9ca3af;
            font-style: italic;
        }

        @media screen and (max-width: 600px) {
            .content {
                padding: 32px 20px;
            }
        }
    </style>
</head>
<body>
    <center class="wrapper">
        <table class="main" width="100%">
            <!-- Header/Logo -->
            <tr>
                <td class="header">
                    <a href="#" class="logo">
                        <span style="color: #1e1b4b;">Up</span>win
                    </a>
                </td>
            </tr>

            <!-- Main Content -->
            <tr>
                <td class="content">
                    <h1>Verify your email address</h1>
                    <p>Hello there,</p>
                    <p>Welcome to <strong>Upwin</strong>! We're excited to have you on board. To get started and secure your account, please verify your email address by clicking the button below.</p>
                    
                    <div class="button-container">
                        <a href="{{url}}" class="button">Verify Email</a>
                    </div>
                    
                    <p>Or copy and paste this link into your browser:</p>
                    <p style="word-break: break-all; font-size: 12px; color: #0ea5e9;">{{url}}</p>

                    <div class="divider"></div>
                    
                    <p class="security-note">This verification link will expire in 24 hours. If you didn't create an account with Upwin, you can safely ignore this email.</p>
                    
                    <p style="margin-top: 32px;">Best regards,<br><strong>The Upwin Team</strong></p>
                </td>
            </tr>

            <!-- Footer -->
            <tr>
                <td class="footer">
                    <p style="margin-bottom: 8px;">&copy; 2026 Upwin Inc. All rights reserved.</p>
                    <p>Silicon Valley, CA • <a href="#" style="color: #9ca3af; text-decoration: underline;">Privacy Policy</a> • <a href="#" style="color: #9ca3af; text-decoration: underline;">Support</a></p>
                </td>
            </tr>
        </table>
    </center>
</body>
</html>