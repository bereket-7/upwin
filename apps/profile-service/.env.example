# Database (must match prisma.config.ts)
PROFILE_DATABASE_URL="postgresql://user:password@localhost:5432/profile_db?schema=public"

# Server
PORT=3009
NODE_ENV=development

# JWT (must match auth-service secret)
JWT_SECRET=change-me-in-local-dev

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Downstream (profile delete → proposal cleanup)
PROPOSAL_SERVICE_URL=http://localhost:3010/api
