// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PortfolioType {
  CUSTOM
  UPWORK_IMPORT
}

model Profile {
  id            String   @id @default(uuid())
  userId        String   @unique // One profile per user
  
  // Basic info
  name          String?
  avatar        String?
  location      String?
  country       String?
  city          String?
  
  // Professional info
  title         String?
  bio           String?
  hourlyRate    Float?
  experienceYrs Int?
  
  // AI preferences (default for all portfolios)
  defaultTone          String?
  defaultWritingStyle  String?

  // Relations
  portfolios    Portfolio[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Portfolio {
  id            String        @id @default(uuid())
  profileId     String
  profile       Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  type          PortfolioType @default(CUSTOM)
  name          String        // e.g., "Full Stack Developer", "My Upwork Portfolio"
  
  // Upwork-specific
  upworkId      String?       @unique
  syncedAt      DateTime?
  
  // Portfolio-specific content
  description   String?
  skills        String[]
  
  // Upwork stats (only for UPWORK_IMPORT)
  totalEarnings String?
  totalJobs     String?
  totalHours    String?
  
  // AI preferences (overrides profile defaults)
  tone          String?
  writingStyle  String?
  
  // Relations
  portfolioItems PortfolioItem[]
  workHistory    WorkHistoryItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([profileId])
  @@index([upworkId])
  @@index([type])
}

model PortfolioItem {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  
  title       String
  image       String?
  description String?
  role        String?
  skills      String[]
  url         String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([portfolioId])
}

model WorkHistoryItem {
  id          String    @id @default(uuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  
  title       String
  company     String?
  dates       String?
  totalEarned String?
  hours       String?
  hourlyRate  String?
  description String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([portfolioId])
}
