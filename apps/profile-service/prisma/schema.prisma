// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PortfolioType {
  CUSTOM
  UPWORK_IMPORT
}

model Profile {
  id            String   @id @default(uuid())
  userId        String   @unique // One profile per user
  
  // Basic info
  name          String?
  avatar        String?
  location      String?
  country       String?
  city          String?
  
  // Professional info
  title         String?
  bio           String?
  hourlyRate    Float?
  experienceYrs Int?
  skills        String[]
  
  // Upwork-specific
  upworkId      String?   @unique
  syncedAt      DateTime?
  
  // Upwork stats
  totalEarnings String?
  totalJobs     String?
  totalHours    String?
  
  // AI preferences
  defaultTone          String?
  defaultWritingStyle  String?

  // Relations
  portfolioItems PortfolioItem[]
  workHistory    WorkHistoryItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([upworkId])
}

model PortfolioItem {
  id          String        @id @default(uuid())
  profileId   String
  profile     Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  type        PortfolioType @default(CUSTOM)
  title       String
  image       String?
  description String?
  role        String?
  skills      String[]
  url         String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([profileId])
  @@index([type])
}

model WorkHistoryItem {
  id          String    @id @default(uuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  title       String
  company     String?
  dates       String?
  totalEarned String?
  hours       String?
  hourlyRate  String?
  description String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([profileId])
}
