          "name": "Verify Email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/verify-email?token=verification-token-here",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-email"],
              "query": [
                {
                  "key": "token",
                  "value": "verification-token-here",
                  "description": "Email verification token from email"
                }
              ]
            },
            "description": "Verify user email address using token sent to email."
          },
          "response": [
            {
              "name": "Success",
