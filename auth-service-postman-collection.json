              "body": "{\n  \"id\": \"uuid-here\",\n  \"email\": \"user@example.com\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"emailVerified\": true,\n  \"provider\": \"local\",\n  \"createdAt\": \"2026-02-06T10:00:00.000Z\"\n}"
