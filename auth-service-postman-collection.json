    {
      "name": "OAuth - Google",
      "item": [
        {
          "name": "Google Login (Redirect)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/google",
              "host": ["{{base_url}}"],
              "path": ["auth", "google"]
            },
            "description": "Initiates Google OAuth flow. Redirects to Google login page. Use this URL in browser or frontend redirect."
          }
        },
        {
          "name": "Exchange Auth Code for Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"auth-code-from-callback\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/exchange",
              "host": ["{{base_url}}"],
              "path": ["auth", "exchange"]
            },
            "description": "Exchange authorization code (from OAuth callback) for access token. Frontend calls this after OAuth redirect."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [],
              "body": "{\n  \"access_token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user\": {\n    \"id\": \"uuid-here\",\n    \"email\": \"user@gmail.com\",\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"provider\": \"google\"\n  }\n}"
            }
          ]
        }
